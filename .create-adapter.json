		"snapmaker",
		"a350",
		"3d printer",
		"laser",
		"cnc",
		"status",
		"job"
	],
	"contributors": [
		"skvarel"
	],
	"authorName": "skvarel",
	"authorGithub": "skvarel",
	"authorEmail": "skvarel@inventwo.com",
	"icon": {
		"data": "data:image/svg+xml;base64,",
		"extension": "svg"
	},
	"features": [
		"adapter"
	],
	"adminFeatures": [],
